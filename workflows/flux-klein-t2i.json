{
  "_meta": {
    "name": "FLUX.2 Klein Text-to-Image",
    "description": "Fast text-to-image generation using FLUX.2 [klein]. Good quality, Apache 2.0 licensed, ~6 GB VRAM.",
    "model_type": "image",
    "params": {
      "prompt": "Text description of the image",
      "seed": "Random seed for reproducibility",
      "size": "Image size as WxH (e.g. 1024x1024)",
      "negative_prompt": "Things to avoid in the image"
    }
  },
  "3": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 42,
      "steps": 20,
      "cfg": 3.5,
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 1.0,
      "model": ["10", 0],
      "positive": ["12", 0],
      "negative": ["12", 1],
      "latent_image": ["11", 0]
    }
  },
  "10": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "flux_klein.safetensors"
    }
  },
  "11": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": 1024,
      "height": 1024,
      "batch_size": 1
    }
  },
  "12": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "a beautiful landscape",
      "clip": ["10", 1]
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["3", 0],
      "vae": ["10", 2]
    }
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "comfyops_flux",
      "images": ["8", 0]
    }
  }
}
