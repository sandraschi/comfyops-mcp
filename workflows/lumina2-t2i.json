{
  "_meta": {
    "name": "Lumina 2 Text-to-Image (Shanghai AI Lab)",
    "description": "Lumina 2 (Shanghai AI Lab) via CLIPTextEncodeLumina2 (system + user prompt) + ModelSamplingAuraFlow. Requires lumina2.safetensors.",
    "model_type": "image",
    "params": {
      "prompt": "Text description of the image",
      "seed": "Random seed for reproducibility",
      "size": "Image size as WxH (e.g. 1024x1024)"
    }
  },
  "10": {
    "class_type": "UNETLoader",
    "inputs": { "unet_name": "lumina2.safetensors", "weight_dtype": "default" }
  },
  "11": {
    "class_type": "CLIPLoader",
    "inputs": { "clip_name": "lumina2_text_encoder.safetensors", "type": "lumina2" }
  },
  "12": {
    "class_type": "CLIPTextEncodeLumina2",
    "inputs": { "system_prompt": "superior", "user_prompt": "a beautiful landscape", "clip": ["11", 0] }
  },
  "13": {
    "class_type": "ModelSamplingAuraFlow",
    "inputs": { "model": ["10", 0], "shift": 1.73 }
  },
  "14": {
    "class_type": "EmptySD3LatentImage",
    "inputs": { "width": 1024, "height": 1024, "batch_size": 1 }
  },
  "15": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["13", 0],
      "seed": 42,
      "steps": 25,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0,
      "positive": ["12", 0],
      "negative": ["12", 0],
      "latent_image": ["14", 0]
    }
  },
  "16": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["15", 0], "vae": ["17", 0] }
  },
  "17": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "lumina2_vae.safetensors" }
  },
  "18": {
    "class_type": "SaveImage",
    "inputs": { "filename_prefix": "comfyops_lumina2", "images": ["16", 0] }
  }
}
