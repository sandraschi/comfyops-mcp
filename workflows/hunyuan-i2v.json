{
  "_meta": {
    "name": "Hunyuan Video 1.5 Image-to-Video (Tencent)",
    "description": "Tencent HunyuanVideo 1.5 I2V via HunyuanVideo15ImageToVideo + TextEncodeHunyuanVideo_ImageToVideo with CLIP vision guidance.",
    "model_type": "video",
    "params": {
      "prompt": "Text description of the video",
      "seed": "Random seed for reproducibility",
      "size": "Video size as WxH (e.g. 848x480)",
      "negative_prompt": "Things to avoid in the video",
      "image_input": "Base64 PNG start frame"
    }
  },
  "3": {
    "class_type": "LoadImage",
    "inputs": { "image": "example.png" }
  },
  "10": {
    "class_type": "UNETLoader",
    "inputs": { "unet_name": "hunyuan_video_1.5_720p_bf16.safetensors", "weight_dtype": "default" }
  },
  "11": {
    "class_type": "DualCLIPLoader",
    "inputs": {
      "clip_name1": "models_t5_umt5-xxl-enc-quanto_int8.safetensors",
      "clip_name2": "models_t5_umt5-xxl-enc-quanto_int8.safetensors",
      "type": "hunyuan_video_15"
    }
  },
  "12": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "hunyuan_video_vae_bf16.safetensors" }
  },
  "13": {
    "class_type": "CLIPVisionLoader",
    "inputs": { "clip_name": "hunyuan_video_clip_vision.safetensors" }
  },
  "14": {
    "class_type": "CLIPVisionEncode",
    "inputs": { "clip_vision": ["13", 0], "image": ["3", 0], "crop": "center" }
  },
  "15": {
    "class_type": "TextEncodeHunyuanVideo_ImageToVideo",
    "inputs": { "clip": ["11", 0], "clip_vision_output": ["14", 0], "prompt": "a cat walking through a garden", "image_interleave": 2 }
  },
  "16": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "blurry, low quality", "clip": ["11", 0] }
  },
  "17": {
    "class_type": "HunyuanVideo15ImageToVideo",
    "inputs": {
      "positive": ["15", 0],
      "negative": ["16", 0],
      "vae": ["12", 0],
      "width": 848,
      "height": 480,
      "length": 33,
      "batch_size": 1,
      "start_image": ["3", 0],
      "clip_vision_output": ["14", 0]
    }
  },
  "18": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["10", 0],
      "seed": 42,
      "steps": 30,
      "cfg": 6.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0,
      "positive": ["17", 0],
      "negative": ["17", 1],
      "latent_image": ["17", 2]
    }
  },
  "19": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["18", 0], "vae": ["12", 0] }
  },
  "20": {
    "class_type": "CreateVideo",
    "inputs": { "images": ["19", 0], "fps": 16 }
  },
  "21": {
    "class_type": "SaveVideo",
    "inputs": { "filename_prefix": "comfyops_hunyuan_i2v", "format": "auto", "codec": "auto", "video": ["20", 0] }
  }
}
