{
  "_meta": {
    "name": "FLUX.2 Klein Text-to-Image (local)",
    "description": "FLUX.2-klein-4b-fp8 via official ComfyUI klein wiring: CLIPLoader(qwen_3_4b, type=flux2) + CLIPTextEncode + Flux2Scheduler. Fast 4B klein - ~3.8GB fp8 weights, fully local.",
    "model_type": "image",
    "params": {
      "prompt": "Text description of the image",
      "seed": "Random seed for reproducibility",
      "size": "Image size as WxH (e.g. 1024x1024)"
    },
    "tags": "t2i,flux2,klein,local"
  },
  "10": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "flux-2-klein-4b-fp8.safetensors",
      "weight_dtype": "fp8_e4m3fn"
    }
  },
  "11": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen_3_4b.safetensors",
      "type": "flux2",
      "device": "default"
    }
  },
  "12": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "a beautiful landscape",
      "clip": ["11", 0]
    }
  },
  "13": {
    "class_type": "FluxGuidance",
    "inputs": {
      "conditioning": ["12", 0],
      "guidance": 3.5
    }
  },
  "14": {
    "class_type": "Flux2Scheduler",
    "inputs": {
      "steps": 20,
      "max_shift": 1024,
      "base_shift": 1024,
      "width": 1024,
      "height": 1024
    }
  },
  "15": {
    "class_type": "EmptyFlux2LatentImage",
    "inputs": {
      "width": 1024,
      "height": 1024,
      "batch_size": 1
    }
  },
  "16": {
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "euler"
    }
  },
  "17": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": 42
    }
  },
  "18": {
    "class_type": "BasicGuider",
    "inputs": {
      "model": ["10", 0],
      "conditioning": ["13", 0]
    }
  },
  "19": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["17", 0],
      "guider": ["18", 0],
      "sampler": ["16", 0],
      "sigmas": ["14", 0],
      "latent_image": ["15", 0]
    }
  },
  "20": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["19", 0],
      "vae": ["21", 0]
    }
  },
  "21": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "flux2-vae.safetensors"
    }
  },
  "22": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["20", 0],
      "filename_prefix": "Flux2-Klein"
    }
  }
}

