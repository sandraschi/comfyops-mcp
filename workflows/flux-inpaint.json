{
  "_meta": {
    "name": "FLUX.2 Inpaint",
    "description": "Inpaint/edit parts of an image using FLUX.2. Replace or modify specific regions.",
    "model_type": "inpaint",
    "params": {
      "prompt": "Description of what to generate in the masked area",
      "image": "Base64 input image",
      "mask": "Base64 mask image (white = area to inpaint)"
    }
  },
  "3": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 42,
      "steps": 25,
      "cfg": 3.5,
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 0.85,
      "model": ["10", 0],
      "positive": ["12", 0],
      "negative": ["12", 1],
      "latent_image": ["11", 0]
    }
  },
  "10": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "flux_klein.safetensors"
    }
  },
  "11": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": 1024,
      "height": 1024,
      "batch_size": 1
    }
  },
  "12": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "fill the masked area with trees",
      "clip": ["10", 1]
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["3", 0],
      "vae": ["10", 2]
    }
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "comfyops_inpaint",
      "images": ["8", 0]
    }
  },
  "15": {
    "class_type": "LoadImage",
    "inputs": {
      "image": ""
    }
  }
}
