{
  "_meta": {
    "name": "FLUX.1 Fill Inpaint",
    "description": "FLUX.1 Fill dev inpaint: FluxEraseNode (object erasure) + InpaintModelConditioning + VAEEncodeForInpaint. Requires flux1-fill-dev.safetensors.",
    "model_type": "inpaint",
    "params": {
      "prompt": "Text description of the replacement content",
      "seed": "Random seed for reproducibility",
      "size": "Image size as WxH",
      "image_input": "Base64 PNG with alpha channel as mask"
    }
  },
  "3": {
    "class_type": "LoadImage",
    "inputs": { "image": "example.png" }
  },
  "4": {
    "class_type": "FluxEraseNode",
    "inputs": { "image": ["3", 0], "mask": ["3", 1], "dilate_pixels": 10, "seed": 42 }
  },
  "10": {
    "class_type": "UNETLoader",
    "inputs": { "unet_name": "flux1-fill-dev.safetensors", "weight_dtype": "default" }
  },
  "11": {
    "class_type": "DualCLIPLoader",
    "inputs": {
      "clip_name1": "t5xxl_fp16.safetensors",
      "clip_name2": "clip_l.safetensors",
      "type": "flux"
    }
  },
  "12": {
    "class_type": "CLIPTextEncodeFlux",
    "inputs": { "clip": ["11", 0], "clip_l": "a repaired area", "t5xxl": "a repaired area", "guidance": 30.0 }
  },
  "13": {
    "class_type": "ModelSamplingFlux",
    "inputs": { "model": ["10", 0], "max_shift": 1.15, "base_shift": 0.5, "width": 1024, "height": 1024 }
  },
  "14": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "ae.safetensors" }
  },
  "15": {
    "class_type": "VAEEncodeForInpaint",
    "inputs": { "pixels": ["4", 0], "vae": ["14", 0], "mask": ["3", 1], "grow_mask_by": 6 }
  },
  "16": {
    "class_type": "InpaintModelConditioning",
    "inputs": {
      "positive": ["12", 0],
      "negative": ["12", 0],
      "vae": ["14", 0],
      "pixels": ["4", 0],
      "mask": ["3", 1],
      "noise_mask": true
    }
  },
  "17": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["13", 0],
      "seed": 42,
      "steps": 20,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0,
      "positive": ["16", 0],
      "negative": ["16", 1],
      "latent_image": ["16", 2]
    }
  },
  "18": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["17", 0], "vae": ["14", 0] }
  },
  "19": {
    "class_type": "SaveImage",
    "inputs": { "filename_prefix": "comfyops_flux_fill", "images": ["18", 0] }
  }
}
