{
  "_meta": {
    "name": "Wan 2.2 Image-to-Video",
    "description": "Wan 2.2 I2V with start frame + CLIP vision reference via WanImageToVideo (shared API surface). ~20 GB VRAM.",
    "model_type": "video",
    "params": {
      "prompt": "Text description of the video",
      "seed": "Random seed for reproducibility",
      "size": "Video size as WxH (e.g. 832x480)",
      "negative_prompt": "Things to avoid in the video",
      "image_input": "Base64 PNG start frame"
    }
  },
  "3": {
    "class_type": "LoadImage",
    "inputs": { "image": "example.png" }
  },
  "10": {
    "class_type": "UNETLoader",
    "inputs": { "unet_name": "wan2.2_i2v_14B_quanto_int8.safetensors", "weight_dtype": "default" }
  },
  "11": {
    "class_type": "DualCLIPLoader",
    "inputs": {
      "clip_name1": "models_t5_umt5-xxl-enc-quanto_int8.safetensors",
      "clip_name2": "models_t5_umt5-xxl-enc-quanto_int8.safetensors",
      "type": "wan"
    }
  },
  "12": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "Wan2.1_VAE_bf16.safetensors" }
  },
  "13": {
    "class_type": "CLIPVisionLoader",
    "inputs": { "clip_name": "Wan2.1_VAE_bf16.safetensors" }
  },
  "14": {
    "class_type": "CLIPVisionEncode",
    "inputs": { "clip_vision": ["13", 0], "image": ["3", 0], "crop": "center" }
  },
  "15": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "a cat walking through a garden", "clip": ["11", 0] }
  },
  "16": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "blurry, low quality", "clip": ["11", 0] }
  },
  "17": {
    "class_type": "VideoLinearCFGGuidance",
    "inputs": { "model": ["10", 0], "min_cfg": 1.0 }
  },
  "18": {
    "class_type": "WanImageToVideo",
    "inputs": {
      "positive": ["15", 0],
      "negative": ["16", 0],
      "vae": ["12", 0],
      "width": 832,
      "height": 480,
      "length": 81,
      "batch_size": 1,
      "clip_vision_output": ["14", 0],
      "start_image": ["3", 0]
    }
  },
  "19": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["17", 0],
      "seed": 42,
      "steps": 20,
      "cfg": 4.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0,
      "positive": ["18", 0],
      "negative": ["18", 1],
      "latent_image": ["18", 2]
    }
  },
  "20": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["19", 0], "vae": ["12", 0] }
  },
  "21": {
    "class_type": "CreateVideo",
    "inputs": { "images": ["20", 0], "fps": 16 }
  },
  "22": {
    "class_type": "SaveVideo",
    "inputs": { "filename_prefix": "comfyops_wan22_i2v", "format": "auto", "codec": "auto", "video": ["21", 0] }
  }
}
