{
  "_meta": {
    "name": "Cosmos Text-to-Video (NVIDIA)",
    "description": "NVIDIA Cosmos 1.5 T2V via EmptyCosmosLatentVideo + CLIPLoader(type=cosmos). Requires cosmos1.5_text2world.safetensors.",
    "model_type": "video",
    "params": {
      "prompt": "Text description of the video",
      "seed": "Random seed for reproducibility",
      "size": "Video size as WxH (e.g. 1280x704)",
      "negative_prompt": "Things to avoid in the video"
    }
  },
  "10": {
    "class_type": "UNETLoader",
    "inputs": { "unet_name": "cosmos1.5_text2world.safetensors", "weight_dtype": "default" }
  },
  "11": {
    "class_type": "CLIPLoader",
    "inputs": { "clip_name": "cosmos_text_encoder.safetensors", "type": "cosmos" }
  },
  "12": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "cosmos_vae.safetensors" }
  },
  "13": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "a robot walking through a garden", "clip": ["11", 0] }
  },
  "14": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "blurry, low quality", "clip": ["11", 0] }
  },
  "15": {
    "class_type": "EmptyCosmosLatentVideo",
    "inputs": { "width": 1280, "height": 704, "length": 121, "batch_size": 1 }
  },
  "16": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["10", 0],
      "seed": 42,
      "steps": 20,
      "cfg": 4.5,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0,
      "positive": ["13", 0],
      "negative": ["14", 0],
      "latent_image": ["15", 0]
    }
  },
  "17": {
    "class_type": "VAEDecodeTiled",
    "inputs": { "samples": ["16", 0], "vae": ["12", 0], "tile_size": 512, "overlap": 64, "temporal_size": 64, "temporal_overlap": 8 }
  },
  "18": {
    "class_type": "CreateVideo",
    "inputs": { "images": ["17", 0], "fps": 24 }
  },
  "19": {
    "class_type": "SaveVideo",
    "inputs": { "filename_prefix": "comfyops_cosmos_t2v", "format": "auto", "codec": "auto", "video": ["18", 0] }
  }
}
