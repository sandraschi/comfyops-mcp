{
  "_meta": {
    "name": "SD 1.5 Text-to-Image",
    "description": "Classic SD1.5 text-to-image. Fast, low VRAM, runnable with sd_v1-5.safetensors.",
    "model_type": "image",
    "params": {
      "prompt": "Text description of the image",
      "seed": "Random seed for reproducibility",
      "size": "Image size as WxH (e.g. 512x512)",
      "negative_prompt": "Things to avoid in the image"
    }
  },
  "3": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "sd_v1-5.safetensors" }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "a beautiful landscape", "clip": ["3", 1] }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "blurry, low quality", "clip": ["3", 1] }
  },
  "6": {
    "class_type": "EmptyLatentImage",
    "inputs": { "width": 512, "height": 512, "batch_size": 1 }
  },
  "7": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["3", 0],
      "seed": 42,
      "steps": 20,
      "cfg": 7.0,
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 1.0,
      "positive": ["4", 0],
      "negative": ["5", 0],
      "latent_image": ["6", 0]
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["7", 0], "vae": ["3", 2] }
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": { "filename_prefix": "comfyops_sd15", "images": ["8", 0] }
  }
}
