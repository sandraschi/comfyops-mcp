{
  "_meta": {
    "name": "ESRGAN 4x Upscale",
    "description": "Real upscale pipeline: UpscaleModelLoader + ImageUpscaleWithModel (RealESRGAN_x4plus). Requires model in models/upscale_models.",
    "model_type": "upscale",
    "params": {
      "image_input": "Base64 PNG image to upscale"
    }
  },
  "3": {
    "class_type": "LoadImage",
    "inputs": { "image": "example.png" }
  },
  "4": {
    "class_type": "UpscaleModelLoader",
    "inputs": { "model_name": "RealESRGAN_x4plus.pth" }
  },
  "5": {
    "class_type": "ImageUpscaleWithModel",
    "inputs": { "upscale_model": ["4", 0], "image": ["3", 0] }
  },
  "6": {
    "class_type": "SaveImage",
    "inputs": { "filename_prefix": "comfyops_esrgan", "images": ["5", 0] }
  }
}
