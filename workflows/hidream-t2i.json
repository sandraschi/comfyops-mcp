{
  "_meta": {
    "name": "HiDream-O1 Text-to-Image",
    "description": "HiDream-O1 (9B) via CLIPTextEncodeHiDream (clip_l + clip_g + t5xxl + llama) + EmptyHiDreamO1LatentImage. Requires hidream_o1_9b.safetensors.",
    "model_type": "image",
    "params": {
      "prompt": "Text description of the image",
      "seed": "Random seed for reproducibility",
      "size": "Image size as WxH (e.g. 1024x1024)"
    }
  },
  "10": {
    "class_type": "UNETLoader",
    "inputs": { "unet_name": "hidream_o1_9b.safetensors", "weight_dtype": "default" }
  },
  "11": {
    "class_type": "DualCLIPLoader",
    "inputs": {
      "clip_name1": "clip_g.safetensors",
      "clip_name2": "t5xxl_fp16.safetensors",
      "type": "hidream"
    }
  },
  "12": {
    "class_type": "CLIPTextEncodeHiDream",
    "inputs": {
      "clip": ["11", 0],
      "clip_l": "a beautiful landscape",
      "clip_g": "a beautiful landscape",
      "t5xxl": "a beautiful landscape",
      "llama": "a beautiful landscape"
    }
  },
  "13": {
    "class_type": "EmptyHiDreamO1LatentImage",
    "inputs": { "width": 1024, "height": 1024, "batch_size": 1 }
  },
  "14": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["10", 0],
      "seed": 42,
      "steps": 20,
      "cfg": 3.5,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0,
      "positive": ["12", 0],
      "negative": ["12", 0],
      "latent_image": ["13", 0]
    }
  },
  "15": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["14", 0], "vae": ["16", 0] }
  },
  "16": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "hidream_o1_vae.safetensors" }
  },
  "17": {
    "class_type": "SaveImage",
    "inputs": { "filename_prefix": "comfyops_hidream", "images": ["15", 0] }
  }
}
