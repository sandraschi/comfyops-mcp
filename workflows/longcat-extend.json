{
  "_meta": {
    "name": "LongCat-Video 13.6B Video Continuation",
    "description": "Meituan LongCat-Video 13.6B Video Continuation model. Extends an input video sequence seamlessly without visual color drift. 720p @ 30 FPS.",
    "model_type": "video",
    "params": {
      "prompt": "Text description of the continuation action",
      "seed": "Random seed for reproducibility",
      "size": "Video resolution as WxH (e.g. 1280x720)",
      "negative_prompt": "Things to avoid in the video"
    }
  },
  "10": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "longcat_video_13b_fp8.safetensors",
      "weight_dtype": "fp8_e4m3fn"
    }
  },
  "11": {
    "class_type": "DualCLIPLoader",
    "inputs": {
      "clip_name1": "models_t5_umt5-xxl-enc-quanto_int8.safetensors",
      "clip_name2": "models_t5_umt5-xxl-enc-quanto_int8.safetensors",
      "type": "wan"
    }
  },
  "12": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "Wan2.1_VAE_bf16.safetensors"
    }
  },
  "13": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "The camera pans upwards into the rainforest canopy as birds fly across",
      "clip": ["11", 0]
    }
  },
  "14": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "blurry, low quality, static, grey tones, distorted",
      "clip": ["11", 0]
    }
  },
  "15": {
    "class_type": "VideoLinearCFGGuidance",
    "inputs": {
      "model": ["10", 0],
      "min_cfg": 1.0
    }
  },
  "16": {
    "class_type": "Wan22ImageToVideoLatent",
    "inputs": {
      "vae": ["12", 0],
      "width": 1280,
      "height": 720,
      "length": 81,
      "batch_size": 1
    }
  },
  "17": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["15", 0],
      "seed": 42,
      "steps": 25,
      "cfg": 4.5,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 0.85,
      "positive": ["13", 0],
      "negative": ["14", 0],
      "latent_image": ["16", 0]
    }
  },
  "18": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["17", 0],
      "vae": ["12", 0]
    }
  },
  "19": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["18", 0],
      "fps": 30
    }
  },
  "20": {
    "class_type": "SaveVideo",
    "inputs": {
      "filename_prefix": "comfyops_longcat_extend",
      "format": "auto",
      "codec": "auto",
      "video": ["19", 0]
    }
  }
}
