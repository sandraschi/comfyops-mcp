{
  "_meta": {
    "name": "FLUX.2 Text-to-Image (local)",
    "description": "FLUX.2 via local UNETLoader + CLIPLoader(type=flux2) + Flux2Scheduler. Note: Flux.2 [pro]/[max] nodes in this registry are cloud-API (BFL key required); this workflow runs fully local.",
    "model_type": "image",
    "params": {
      "prompt": "Text description of the image",
      "seed": "Random seed for reproducibility",
      "size": "Image size as WxH (e.g. 1024x1024)"
    }
  },
  "10": {
    "class_type": "UNETLoader",
    "inputs": { "unet_name": "flux2-dev.safetensors", "weight_dtype": "default" }
  },
  "11": {
    "class_type": "CLIPLoader",
    "inputs": { "clip_name": "models_t5_umt5-xxl-enc-quanto_int8.safetensors", "type": "flux2" }
  },
  "12": {
    "class_type": "CLIPTextEncodeFlux",
    "inputs": { "clip": ["11", 0], "clip_l": "a beautiful landscape", "t5xxl": "a beautiful landscape", "guidance": 3.5 }
  },
  "13": {
    "class_type": "FluxGuidance",
    "inputs": { "conditioning": ["12", 0], "guidance": 3.5 }
  },
  "14": {
    "class_type": "Flux2Scheduler",
    "inputs": { "steps": 20, "width": 1024, "height": 1024 }
  },
  "15": {
    "class_type": "EmptyFlux2LatentImage",
    "inputs": { "width": 1024, "height": 1024, "batch_size": 1 }
  },
  "16": {
    "class_type": "KSamplerSelect",
    "inputs": { "sampler_name": "euler" }
  },
  "17": {
    "class_type": "RandomNoise",
    "inputs": { "noise_seed": 42 }
  },
  "18": {
    "class_type": "BasicGuider",
    "inputs": { "model": ["10", 0], "conditioning": ["13", 0] }
  },
  "19": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["17", 0],
      "guider": ["18", 0],
      "sampler": ["16", 0],
      "sigmas": ["14", 0],
      "latent_image": ["15", 0]
    }
  },
  "20": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["19", 0], "vae": ["21", 0] }
  },
  "21": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "flux2_ae.safetensors" }
  },
  "22": {
    "class_type": "SaveImage",
    "inputs": { "filename_prefix": "comfyops_flux2", "images": ["20", 0] }
  }
}
