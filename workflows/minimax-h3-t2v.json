{
  "_meta": {
    "name": "MiniMax H3 Text-to-Video",
    "description": "MiniMax H3 omni-modal t2v via the native ComfyUI MiniMaxH3ImageToVideo node (ComfyUI >= 0.33). Generates video AND native stereo audio (voice, SFX, music) in a single pass. 768px short edge canvas, 24fps, up to ~15s. pruned int8_convrot + nvfp4 text encoder, ~16 GB VRAM.",
    "model_type": "video",
    "params": {
      "prompt": "Describe shots, camera moves AND audio (dialogue, SFX, music) in one block",
      "seed": "Random seed for reproducibility",
      "size": "Video size as WxH (e.g. 864x480; 768px short edge, multiple of 32)",
      "negative_prompt": "Ignored - MiniMax H3 takes a single prompt block"
    },
    "required_packs": ["comfy-core"],
    "notes": "Update ComfyUI to >= 0.33.0 for native MiniMax H3 nodes. Turbo LoRA path enabled by default (8 steps). Describe audio in the prompt - H3 synthesizes it natively.",
    "source_url": "https://github.com/Comfy-Org/workflow_templates/blob/main/templates/video_minimax_h3_t2v.json"
  },
  "1": {
    "class_type": "UNETLoader",
    "inputs": { "unet_name": "minimax_h3_fl2va_pruned_int8_convrot.safetensors", "weight_dtype": "default" }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": { "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors", "type": "minimax", "device": "default" }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "minimax_h3_video_vae_fp16.safetensors" }
  },
  "4": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "minimax_h3_audio_vae_fp32.safetensors" }
  },
  "5": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "model": ["1", 0],
      "lora_name": "minimax_h3_fl2v_turbo_8step_v1.0_comfyui_bf16.safetensors",
      "strength_model": 1.0
    }
  },
  "6": {
    "class_type": "ComfySwitchNode",
    "inputs": { "on_false": ["1", 0], "on_true": ["5", 0], "switch": true }
  },
  "7": {
    "class_type": "RandomNoise",
    "inputs": { "noise_seed": 42 }
  },
  "8": {
    "class_type": "KSamplerSelect",
    "inputs": { "sampler_name": "res_multistep" }
  },
  "9": {
    "class_type": "BasicScheduler",
    "inputs": { "model": ["6", 0], "scheduler": "simple", "steps": 8, "denoise": 1.0 }
  },
  "10": {
    "class_type": "BasicGuider",
    "inputs": { "model": ["6", 0], "conditioning": ["11", 0] }
  },
  "11": {
    "class_type": "MiniMaxH3ImageToVideo",
    "inputs": {
      "clip": ["2", 0],
      "vae": ["3", 0],
      "prompt": "A cat walking through a garden at golden hour, camera slowly following it, birdsong and soft wind in the background.",
      "width": 864,
      "height": 480,
      "length": 124
    }
  },
  "12": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["7", 0],
      "guider": ["10", 0],
      "sampler": ["8", 0],
      "sigmas": ["9", 0],
      "latent_image": ["11", 1]
    }
  },
  "13": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["12", 0], "vae": ["3", 0] }
  },
  "14": {
    "class_type": "VAEDecodeAudio",
    "inputs": { "samples": ["12", 0], "vae": ["4", 0] }
  },
  "15": {
    "class_type": "CreateVideo",
    "inputs": { "images": ["13", 0], "audio": ["14", 0], "fps": 24, "bit_depth": 8 }
  },
  "16": {
    "class_type": "SaveVideo",
    "inputs": { "filename_prefix": "comfyops_minimax_h3_t2v", "format": "auto", "codec": "auto", "video": ["15", 0] }
  }
}
