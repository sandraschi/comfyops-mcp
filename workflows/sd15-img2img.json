{
  "_meta": {
    "name": "SD 1.5 Image-to-Image",
    "description": "SD1.5 img2img restyle with configurable denoise strength. Lower denoise = closer to source.",
    "model_type": "edit",
    "params": {
      "prompt": "Text description of the target style/content",
      "seed": "Random seed for reproducibility",
      "size": "Image size as WxH",
      "negative_prompt": "Things to avoid",
      "image_input": "Base64 PNG source image"
    }
  },
  "3": {
    "class_type": "LoadImage",
    "inputs": { "image": "example.png" }
  },
  "4": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "sd_v1-5.safetensors" }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "watercolor painting", "clip": ["4", 1] }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "blurry, low quality", "clip": ["4", 1] }
  },
  "7": {
    "class_type": "VAEEncode",
    "inputs": { "pixels": ["3", 0], "vae": ["4", 2] }
  },
  "8": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["4", 0],
      "seed": 42,
      "steps": 25,
      "cfg": 7.0,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 0.6,
      "positive": ["5", 0],
      "negative": ["6", 0],
      "latent_image": ["7", 0]
    }
  },
  "9": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["8", 0], "vae": ["4", 2] }
  },
  "10": {
    "class_type": "SaveImage",
    "inputs": { "filename_prefix": "comfyops_sd15_img2img", "images": ["9", 0] }
  }
}
