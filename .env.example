# ComfyUI connection
COMFYOPS_COMFYUI_HOST=127.0.0.1
COMFYOPS_COMFYUI_PORT=11086
COMFYOPS_COMFYUI_DIR=D:\ComfyUI
# Python for the ComfyUI sidecar (defaults to ComfyUI\.venv\Scripts\python.exe)
# COMFYOPS_COMFYUI_PYTHON=D:\ComfyUI\.venv\Scripts\python.exe

# Hugging Face token - required for gated repos (e.g. FLUX.2-dev VAE).
# Create at https://huggingface.co/settings/tokens (read access is enough).
# COMFYOPS_HF_TOKEN=hf_...

# Generation timeout (seconds) - raised to 900 for first-run model loads
COMFYOPS_TIMEOUT=900

# Custom node auto-install via ComfyUI-Manager (1=on)
COMFYOPS_AUTO_INSTALL_NODES=1
COMFYOPS_MANAGER_BOOTSTRAP=1
COMFYOPS_MANAGER_INSTALL_TIMEOUT=600

# Model paths - MUST point at the ComfyUI model tree (list_models scans this)
COMFYOPS_MODELS_DIR=D:\ComfyUI\models

# Prompt refinement LLM (Ollama, optional)
# COMFYOPS_OLLAMA_URL=http://127.0.0.1:11434
# COMFYOPS_LLM_MODEL=muse-glimmer-131k:latest

# Webapp
COMFYOPS_FRONTEND_PORT=11088

# Ingest targets (Phase 2, not yet built)
COMFYOPS_IMMICH_URL=
COMFYOPS_IMMICH_API_KEY=
COMFYOPS_PLEX_URL=
COMFYOPS_PLEX_TOKEN=
