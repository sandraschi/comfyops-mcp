# ComfyUI connection
COMFYOPS_COMFYUI_HOST=127.0.0.1
COMFYOPS_COMFYUI_PORT=11086
COMFYOPS_COMFYUI_DIR=D:\ComfyUI
# Python for ComfyUI-Manager cm-cli (defaults to ComfyUI\.venv\Scripts\python.exe)
# COMFYOPS_COMFYUI_PYTHON=D:\ComfyUI\.venv\Scripts\python.exe

# Custom node auto-install via ComfyUI-Manager (1=on)
COMFYOPS_AUTO_INSTALL_NODES=1
COMFYOPS_MANAGER_BOOTSTRAP=1
COMFYOPS_MANAGER_INSTALL_TIMEOUT=600

# Model paths
COMFYOPS_MODELS_DIR=D:\models\comfyui

# Webapp
COMFYOPS_FRONTEND_PORT=11088

# Ingest targets
COMFYOPS_IMMICH_URL=
COMFYOPS_IMMICH_API_KEY=
COMFYOPS_PLEX_URL=
COMFYOPS_PLEX_TOKEN=
